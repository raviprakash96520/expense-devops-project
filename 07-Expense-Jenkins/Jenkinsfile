pipeline {
    agent {
        label 'agent-1'
    }

    environment {
        AWS_ACCOUNT_ID      = '376159574294'
        AWS_REGION          = 'us-east-1'
        ECR_REGISTRY        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        BACKEND_IMAGE_NAME  = 'expense-backend'
        FRONTEND_IMAGE_NAME = 'expense-frontend'
        IMAGE_TAG           = "${BUILD_NUMBER}"

        BACKEND_DIR         = '07-Expense-Jenkins/backend-CI'
        FRONTEND_DIR        = '07-Expense-Jenkins/frontend'
        HELM_DIR            = '07-Expense-Jenkins/helm'

        GIT_REPO_URL        = 'github.com/raviprakash96520/expense-devops-project.git'
        RECIPIENT_EMAIL     = 'ravireddy6198@gmail.com'

        GIT_CREDENTIALS_ID   = 'github-credentials-id'
        SONAR_CREDENTIALS_ID = 'sonarqube-token'
        SNYK_TOKEN_ID        = 'snyk-api-token'
        AWS_CREDENTIALS_ID   = 'aws-ecr-credentials'
    }

    stages {

        stage('1. Checkout Code') {
            steps {
                echo 'Checking out code from GitHub...'
                checkout scm
            }
        }

        stage('2. Secrets Scan - GitLeaks') {
            steps {
                echo 'Running GitLeaks scan...'

                sh '''
                    gitleaks detect \
                        --source=. \
                        --report-format=json \
                        --report-path=gitleaks-report.json \
                        --verbose || true
                '''
            }
        }

        stage('3. Dependency Scan - Snyk') {
            steps {
                echo 'Running Snyk dependency scanning...'

                withCredentials([
                    string(
                        credentialsId: "${SNYK_TOKEN_ID}",
                        variable: 'SNYK_TOKEN'
                    )
                ]) {
                    sh '''
                        snyk auth "$SNYK_TOKEN"

                        (
                            cd "$WORKSPACE/$BACKEND_DIR"

                            snyk test \
                                --json \
                                > "$WORKSPACE/snyk-backend-report.json" || true
                        )

                        (
                            cd "$WORKSPACE/$FRONTEND_DIR"

                            snyk test \
                                --json \
                                > "$WORKSPACE/snyk-frontend-report.json" || true
                        )
                    '''
                }
            }
        }

       stage('4. SAST Scan - SonarQube') {
    steps {
        echo 'Running SonarQube SAST and code quality scan...'

        withSonarQubeEnv('SonarQube') {
            sh '''
                sonar-scanner \
                    -Dsonar.projectKey=expense-app \
                    -Dsonar.projectName="Expense Application" \
                    -Dsonar.sources="$BACKEND_DIR,$FRONTEND_DIR"
            '''
        }
    }
}

stage('5. SonarQube Quality Gate Check') {
    steps {
        echo 'Waiting for SonarQube Quality Gate result...'

        timeout(time: 5, unit: 'MINUTES') {
            script {
                def qg = waitForQualityGate()

                echo "SonarQube Quality Gate Status: ${qg.status}"

                if (qg.status != 'OK') {
                    echo """
                    WARNING:
                    SonarQube Quality Gate status is ${qg.status}.
                    Pipeline will continue for DevSecOps testing.
                    """
                } else {
                    echo 'SonarQube Quality Gate Passed.'
                }
            }
        }
    }
}
        stage('6. IaC / Helm Scan - Checkov') {
            steps {
                echo 'Scanning Helm charts with Checkov...'

                sh '''
                    checkov \
                        -d "$HELM_DIR" \
                        -o json \
                        --soft-fail \
                        > checkov-report.json || true
                '''
            }
        }

        stage('7. Docker Build Images') {
            steps {
                echo 'Building Backend and Frontend Docker images...'

                script {
                    docker.build(
                        "${ECR_REGISTRY}/${BACKEND_IMAGE_NAME}:${IMAGE_TAG}",
                        "${BACKEND_DIR}"
                    )

                    docker.build(
                        "${ECR_REGISTRY}/${FRONTEND_IMAGE_NAME}:${IMAGE_TAG}",
                        "${FRONTEND_DIR}"
                    )
                }
            }
        }

        stage('8. Generate SBOM - Syft') {
            steps {
                echo 'Generating Software Bill of Materials...'

                sh '''
                    syft \
                        "$ECR_REGISTRY/$BACKEND_IMAGE_NAME:$IMAGE_TAG" \
                        -o cyclonedx-json=sbom-backend-report.json

                    syft \
                        "$ECR_REGISTRY/$FRONTEND_IMAGE_NAME:$IMAGE_TAG" \
                        -o cyclonedx-json=sbom-frontend-report.json
                '''
            }
        }

        stage('9. Container Scan - Trivy') {
    steps {
        echo 'Scanning Backend image with Trivy...'

        sh '''
            trivy image \
                --format template \
                --template "@/usr/local/share/trivy/templates/html.tpl" \
                -o trivy-backend-report.html \
                "$ECR_REGISTRY/$BACKEND_IMAGE_NAME:$IMAGE_TAG" || true
        '''

        echo 'Scanning Frontend image with Trivy...'

        sh '''
            trivy image \
                --format template \
                --template "@/usr/local/share/trivy/templates/html.tpl" \
                -o trivy-frontend-report.html \
                "$ECR_REGISTRY/$FRONTEND_IMAGE_NAME:$IMAGE_TAG" || true
        '''
    }
}
      stage('10. Push Images to AWS ECR') {
    steps {
        echo 'Pushing Docker images to AWS ECR...'

        withCredentials([
            [
                $class: 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'aws-ecr-credentials',
                accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
            ]
        ]) {
            sh '''
                echo "Checking AWS authentication..."
                aws sts get-caller-identity

                aws ecr get-login-password \
                    --region "$AWS_REGION" |
                docker login \
                    --username AWS \
                    --password-stdin "$ECR_REGISTRY"

                docker push \
                    "$ECR_REGISTRY/$BACKEND_IMAGE_NAME:$IMAGE_TAG"

                docker push \
                    "$ECR_REGISTRY/$FRONTEND_IMAGE_NAME:$IMAGE_TAG"
            '''
        }
    }
}  

      
        stage('11. Update Helm values-dev.yaml for ArgoCD') {
            steps {
                echo 'Updating imageVersion inside values-dev.yaml...'

                withCredentials([
                    usernamePassword(
                        credentialsId: "${GIT_CREDENTIALS_ID}",
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    sh '''
                        rm -rf manifest-repo

                        git clone \
                            https://$GIT_USER:$GIT_PASSWORD@$GIT_REPO_URL \
                            manifest-repo

                        cd "manifest-repo/$HELM_DIR"

                        NEW_TAG="$IMAGE_TAG"

                        sed -i \
                            '/backend:/,/frontend:/ s|imageVersion:.*|imageVersion: "'"$NEW_TAG"'"|' \
                            values-dev.yaml

                        sed -i \
                            '/frontend:/,$ s|imageVersion:.*|imageVersion: "'"$NEW_TAG"'"|' \
                            values-dev.yaml

                        echo "Updated values-dev.yaml:"
                        cat values-dev.yaml

                        git config user.email "jenkins-ci@example.com"
                        git config user.name "Jenkins CI Bot"

                        git add values-dev.yaml

                        if ! git diff --cached --quiet; then

                            git commit \
                                -m "chore(cd): update imageVersion to $NEW_TAG [skip ci]"

                            git push origin main

                        else
                            echo "No changes detected in values-dev.yaml"
                        fi
                    '''
                }
            }
        }
    }

    post {

        always {
            echo 'Archiving generated security reports...'

            archiveArtifacts(
                artifacts: '**/*report*.*, **/sbom-*.json',
                allowEmptyArchive: true
            )

            echo 'Cleaning up local Docker images...'

            sh '''
                docker rmi \
                    "$ECR_REGISTRY/$BACKEND_IMAGE_NAME:$IMAGE_TAG" || true

                docker rmi \
                    "$ECR_REGISTRY/$FRONTEND_IMAGE_NAME:$IMAGE_TAG" || true
            '''

            cleanWs()
        }

        success {
            emailext(
                to: "${RECIPIENT_EMAIL}",

                subject: """
                    SUCCESSFUL: Job '${env.JOB_NAME}' [Build #${env.BUILD_NUMBER}]
                """.trim(),

                body: """
                    <html>
                    <body style="font-family: Arial, sans-serif;">

                        <h2 style="color: green;">
                            Build Status: SUCCESS
                        </h2>

                        <p>Hi Team,</p>

                        <p>
                            The DevSecOps pipeline execution for
                            <b>${env.JOB_NAME}</b>
                            (Build #${env.BUILD_NUMBER})
                            completed successfully.
                        </p>

                        <h3>Docker Images</h3>

                        <ul>
                            <li>
                                <b>Backend:</b>
                                ${ECR_REGISTRY}/${BACKEND_IMAGE_NAME}:${IMAGE_TAG}
                            </li>

                            <li>
                                <b>Frontend:</b>
                                ${ECR_REGISTRY}/${FRONTEND_IMAGE_NAME}:${IMAGE_TAG}
                            </li>
                        </ul>

                        <h3>ArgoCD Deployment</h3>

                        <p>
                            Helm <b>values-dev.yaml</b> has been updated with
                            imageVersion <b>${IMAGE_TAG}</b>.
                        </p>

                        <p>
                            ArgoCD can detect the Git change and synchronize
                            the new application version to Kubernetes.
                        </p>

                        <h3>Security Scans</h3>

                        <ul>
                            <li>GitLeaks - Secrets Scan</li>
                            <li>Snyk - Dependency Scan</li>
                            <li>SonarQube - SAST / Code Quality</li>
                            <li>Checkov - Helm / IaC Scan</li>
                            <li>Syft - SBOM Generation</li>
                            <li>Trivy - Container Vulnerability Scan</li>
                        </ul>

                        <h3>Generated Reports</h3>

                        <ul>
                            <li>gitleaks-report.json</li>
                            <li>snyk-backend-report.json</li>
                            <li>snyk-frontend-report.json</li>
                            <li>checkov-report.json</li>
                            <li>sbom-backend-report.json</li>
                            <li>sbom-frontend-report.json</li>
                            <li>trivy-backend-report.html</li>
                            <li>trivy-frontend-report.html</li>
                        </ul>

                        <p>
                            Jenkins Build:
                            <a href="${env.BUILD_URL}">
                                ${env.BUILD_URL}
                            </a>
                        </p>

                    </body>
                    </html>
                """,

                mimeType: 'text/html',
                attachLog: true
            )
        }

        failure {
            emailext(
                to: "${RECIPIENT_EMAIL}",

                subject: """
                    FAILED: Job '${env.JOB_NAME}' [Build #${env.BUILD_NUMBER}]
                """.trim(),

                body: """
                    <html>
                    <body style="font-family: Arial, sans-serif;">

                        <h2 style="color: red;">
                            Build Status: FAILED
                        </h2>

                        <p>Hi Team,</p>

                        <p>
                            The DevSecOps pipeline execution for
                            <b>${env.JOB_NAME}</b>
                            (Build #${env.BUILD_NUMBER})
                            has failed.
                        </p>

                        <p>
                            Check the Jenkins console logs and archived
                            security reports for troubleshooting.
                        </p>

                        <p>
                            Jenkins Build:
                            <a href="${env.BUILD_URL}">
                                ${env.BUILD_URL}
                            </a>
                        </p>

                    </body>
                    </html>
                """,

                mimeType: 'text/html',
                attachLog: true
            )
        }
    }
}